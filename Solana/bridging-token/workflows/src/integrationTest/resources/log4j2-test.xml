<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="debug">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info"/>

        <Logger name="net.corda" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="net.corda.testing.node.internal" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="net.corda.samples.solana.bridging.token.BridgingTokenDriverTest" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

    </Loggers>
</Configuration>
